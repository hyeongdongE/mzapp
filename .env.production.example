# Copy to .env.production on the mini PC. Never commit the real file.
TREND_RADAR_DOMAIN=trend.example.com
POSTGRES_DB=trend_radar
POSTGRES_USER=trend_radar
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode reserved characters in the password used below.
DATABASE_URL=postgresql+psycopg://trend_radar:replace-with-a-long-random-password@db:5432/trend_radar
USER_AGENT=TrendRadarPoC/0.1 (admin@example.com)
POC_START_DATE=2026-09-20
APP_IMAGE_TAG=latest
INTERNAL_API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
